# Minimal configuration
# Embedding provider: RAG_PROVIDER=gemini | openai | azure-openai | lexical.
# Unset = auto: the first of gemini, openai, azure-openai with credentials,
# else lexical. Vector providers fall back to lexical and hydrate eagerly;
# lexical has no fallback and hydrates lazily.

# RAG_PROVIDER=
# GEMINI_API_KEY=your_key_here

# OpenAI
# OPENAI_API_KEY=
# OPENAI_EMBED_MODEL=text-embedding-3-large
# OPENAI_EMBED_DIMENSIONS=        # optional, e.g. 1024 (changing it re-embeds)
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_EMBED_BATCH_SIZE=64

# Azure OpenAI (key, endpoint, and deployment are all required)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_EMBED_DEPLOYMENT=
# AZURE_OPENAI_EMBED_MODEL=text-embedding-3-large   # model behind the deployment; part of the cache identity
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_EMBED_DIMENSIONS=  # optional, e.g. 1024 (changing it re-embeds)
# AZURE_OPENAI_EMBED_BATCH_SIZE=64

# Optional: explicit cache directories
# MCP_DATA_DIR=
# MCP_DATA_CACHE_DIR=
# RAG_CACHE_DIR=
# RAG_MODEL_CACHE_DIR=

# Optional: startup behavior
# MCP_DATA_AUTO_DOWNLOAD=true
# MCP_DATA_REFRESH_ON_START=false

# Optional: force hydration mode override
# MCP_DATA_HYDRATION_MODE=eager

# Optional: prebuilt index (release asset prebuilt-rag-index-<provider>-<version>.tar.gz)
# RAG_PREBUILT_INDEX_AUTO_DOWNLOAD=true
# RAG_PREBUILT_INDEX_URL=
# RAG_PREBUILT_INDEX_URL_GEMINI=
# RAG_PREBUILT_INDEX_TIMEOUT_MS=180000

# Optional: prewarm behavior
# RAG_PREWARM=true
# RAG_PREWARM_BLOCK=false

# Optional: Gemini request tuning (GEMINI_RETRY_* and GEMINI_REQUEST_THROTTLE_MS
# apply to every HTTP embedding provider)
# GEMINI_EMBED_MODEL=gemini-embedding-001
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_EMBED_BATCH_SIZE=16
# GEMINI_RETRY_MAX_ATTEMPTS=5
# GEMINI_RETRY_BASE_DELAY_MS=500
# GEMINI_RETRY_MAX_DELAY_MS=10000
# GEMINI_REQUEST_THROTTLE_MS=0

# Optional: data download retry tuning
# MCP_DATA_DOWNLOAD_TIMEOUT_MS=180000
# MCP_DATA_DOWNLOAD_RETRY_MAX_ATTEMPTS=3
# MCP_DATA_DOWNLOAD_RETRY_BASE_DELAY_MS=500
# MCP_DATA_DOWNLOAD_RETRY_MAX_DELAY_MS=5000

# Optional: observability
# Console logs go to stderr. Format: json (default, one JSON object per line) | text (readable lines)
# MCP_LOG_FORMAT=json
# MCP_VERBOSE_LOGS=false
# MCP_LOG_LEVEL=info
# Request logs (one per tools/call / resources/read). stderr gets a summary:
# tool or uri, outcome, duration, response size, and requester info (user agent, opt-in client id).
# MCP_LOG_REQUESTS=true
# Detailed request log directory: daily requests-<YYYY-MM-DD>-<host>.jsonl files with
# arguments and full response. Unset = no detailed log.
# MCP_REQUEST_LOG_DIR=
# Delete detailed log files older than N days (0 = keep forever)
# MCP_REQUEST_LOG_RETENTION_DAYS=30
# Max JSON chars per logged arguments/response field in the detailed log (0 = no limit)
# MCP_LOG_MAX_FIELD_CHARS=0
# HTTP requester identity (personal data, opt-in): off (default) | hash (salted client_id) | full (client_ip)
# MCP_LOG_CLIENT_IP=off
# Secret salt for client_id; set it (e.g. as an ACA secret) for ids that stay stable across restarts.
# If unset, a per-process salt is used. Never store it next to the request logs.
# MCP_LOG_IP_SALT=
# Honor X-Forwarded-For (right-most entry) only when a trusted proxy sets it, e.g. Azure Container Apps ingress
# MCP_LOG_TRUST_PROXY=false
